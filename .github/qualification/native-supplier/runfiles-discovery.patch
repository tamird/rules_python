+#[cfg(unix)]
+fn link_target(path: &str) -> Option<String> {
+    let mut buf = [0_u8; 4096];
+    let len = platform::read_link(path, &mut buf);
+    if len <= 0 || len as usize == buf.len() {
+        return None;
+    }
+    let target = core::str::from_utf8(&buf[..len as usize]).ok()?;
+    if target.starts_with('/') {
+        return Some(String::from(target));
+    }
+    // Resolve a relative link in its parent, independently of the caller's cwd.
+    let (dir, _) = path.rsplit_once('/')?;
+    Some(String::from(dir) + "/" + target)
